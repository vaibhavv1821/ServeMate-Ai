{
  "name": "servmate-backend",
  "version": "1.0.0",
  "description": "ServMate REST API - Modular Monolith",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "test": "node --test tests/phase2.test.js",
    "test:phase1": "node --test tests/auth.test.js"
  },
  "dependencies": {
    "@upstash/redis": "^1.38.3",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "multer-storage-cloudinary": "^4.0.0",
    "socket.io": "^4.8.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "prisma": "^5.22.0",
    "socket.io-client": "^4.8.3"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true,
    "core-js@3.50.0": true
  }
}
